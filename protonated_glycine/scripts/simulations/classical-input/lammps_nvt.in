variable        T   equal  10
#variable        dt  equal  0.2
variable        dt  equal  0.05
#variable        P   equal  20.0
variable        nsteps  equal 2000000
#variable        nsteps  equal 100
variable        thermo_freq equal 8
variable        dump_freq equal 8

processors      * * * map xyz

units           real
atom_style      full
#boundary        p p p
#dimension 3
boundary f f f
read_data       pgl-1-h2o.data
#read_restart    restart.old

pair_style      mbx 25.0
pair_modify     mix arithmetic

bond_style      none
angle_style     none
dihedral_style  none
improper_style  none

pair_coeff      * * 0.0 0.0

neighbor        2.0 bin
neigh_modify    every 1 delay 1 check no

timestep        ${dt}

compute         mbx all pair mbx
variable        e1bpip    equal c_mbx[1]
variable        e2bpip    equal c_mbx[2]
variable        e3bpip    equal c_mbx[3]
variable        e4bpip    equal c_mbx[4]
variable        edisp     equal c_mbx[5]
variable        ebuck     equal c_mbx[6]
variable        eele      equal c_mbx[7]
variable        etot      equal c_mbx[8]

#fix             1 all npt temp ${T} ${T} $(1000.0*dt) iso ${P} ${P} $(4000.0*dt)
#fix             1 all nve 
#fix             walls all wall/reflect xlo EDGE xhi EDGE ylo EDGE yhi EDGE zlo EDGE zhi EDGE
fix             1 all nvt temp ${T} ${T} $(100.0*dt)
fix             2 all mbx 2 glyh+ 1 8 11 1 2 2 2 3 4 4 5 6 7 8 h2o 9 10 3 9 10 10 json mbx.json print/settings print/dipoles

# Dipole moments in Debye units ##
variable dipnorm_tot atom sqrt(f_2[7]*f_2[7]+f_2[8]*f_2[8]+f_2[9]*f_2[9])/0.2081943 # original (total dipole)
variable dipnorm_ind atom sqrt(f_2[4]*f_2[4]+f_2[5]*f_2[5]+f_2[6]*f_2[6])/0.2081943 # induced
variable dipnorm_perm atom sqrt(f_2[1]*f_2[1]+f_2[2]*f_2[2]+f_2[3]*f_2[3])/0.2081943 # perm

variable dipx_perm atom f_2[1]/0.2081943
variable dipy_perm atom f_2[2]/0.2081943
variable dipz_perm atom f_2[3]/0.2081943
variable dipx_ind atom f_2[4]/0.2081943
variable dipy_ind atom f_2[5]/0.2081943
variable dipz_ind atom f_2[6]/0.2081943

variable dipx atom f_2[7]/0.2081943
variable dipy atom f_2[8]/0.2081943
variable dipz atom f_2[9]/0.2081943

variable dipnorm atom sqrt(f_2[7]*f_2[7]+f_2[8]*f_2[8]+f_2[9]*f_2[9])/0.2081943

velocity        all create ${T} 428459 rot yes dist gaussian
velocity        all zero linear
velocity        all zero angular
 

#thermo_style	custom step time temp etotal pe ke density lx ly lz vol pxx pyy pzz press
thermo_style    custom step time temp etotal ke pe enthalpy density lx ly lz vol pxx pyy pzz press v_e1bpip v_e2bpip v_e3bpip v_e4bpip v_edisp v_ebuck v_eele v_etot
thermo          ${thermo_freq}
thermo_modify   flush yes

#fix             thermo_print all print 100 "$(step) $(0.001*time) $(temp) $(etotal) $(pe) $(ke) $(density) $(lx) $(ly) $(lz) $(vol) $(pxx) $(pyy) $(pzz) $(press)" file thermo.out screen no title "# step time temp etotal pe ke density lx ly lz vol pxx pyy pzz press"
fix             verbose_mbx_thermo_print all print ${thermo_freq} "$(step) $(0.001*time) $(temp) $(etotal) $(ke) $(pe) $(enthalpy) $(density) $(lx) $(ly) $(lz) $(vol) $(pxx) $(pyy) $(pzz) $(press) $(v_e1bpip) $(v_e2bpip) $(v_e3bpip) $(v_e4bpip) $(v_edisp) $(v_ebuck) $(v_eele) $(v_etot)" file mbx_thermo.out screen no title "# step time temp etotal ke pe enthalpy density lx ly lz vol pxx pyy pzz press e1bpip e2bpip e3bpip e4bpip edisp ebuck eele etot"

# dump as lammpstrj has box information
dump            1 all custom ${dump_freq} dump.lammpstrj id mol type q x y z
dump_modify     1 append no sort id format line "%d %d %d %8.4f %15.8f %15.8f %15.8f"

# dump as xyz
dump             xyzout all xyz ${dump_freq} dump.xyz
dump_modify      xyzout element N H C H C O O H O H
dump_modify      xyzout format line "%s %20.15g  %20.15g  %20.15g"
dump_modify      xyzout sort id append yes

dump            4 all custom ${dump_freq} dump.dipoles id mol type q vx vy vz v_dipx_perm v_dipy_perm v_dipz_perm v_dipnorm_perm v_dipx_ind v_dipy_ind v_dipz_ind v_dipnorm_ind
dump_modify     4 sort id

#dump            5 all custom ${dump_freq} DIPMOL_CMD id type v_dipx_perm v_dipy_perm v_dipz_perm v_dipnorm_perm
#dump_modify     5 sort id

#dump            6 all custom ${dump_freq} DIPIND_CMD id type v_dipx_ind v_dipy_ind v_dipz_ind v_dipnorm_ind
#dump_modify     6 sort id

restart         10 restart.1 restart.2

run             ${nsteps}  upto

write_data      final.data nocoeff
write_restart   restart.new
