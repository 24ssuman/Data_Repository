<simulation verbosity='low'>
  <output prefix='simulation'>
    <properties filename='out' stride='8'>  [step, time{picosecond}, conserved{electronvolt}, temperature{kelvin}, kinetic_md{electronvolt}, potential{electronvolt}, pot_component{electronvolt}(0), pot_component{electronvolt}(1), pot_component{electronvolt}(2), density{g/cm3}, volume{angstrom3}, pressure_md{atmosphere}] </properties>
    <trajectory filename='pos' format='xyz' stride='8' cell_units='angstrom'> positions{angstrom} </trajectory>
    <trajectory filename='vel' format='xyz' stride='8' cell_units='angstrom'> velocities{m/s} </trajectory>
    <trajectory filename='for' format='xyz' stride='8' cell_units='angstrom'> forces{ev/ang} </trajectory>
    <checkpoint filename='restart' stride='8' overwrite='true'/>
  </output>
  <total_steps> 1000000 </total_steps>
  <ffsocket mode='unix' pbc='true' name='pgl'>
    <address> pgl </address>
  </ffsocket>
  <ffsocket mode='unix' pbc='true' name='qc'>
    <address> qc </address>
  </ffsocket>
  <ffsocket mode='unix' pbc='true' name='qc_mbpol'>
    <address> qc_mbpol </address>
  </ffsocket>
  <system>
    <initialize nbeads='1'>
      <file mode='chk' > RESTART </file>
      <cell mode='abc' units='angstrom'> [50.0, 50.0, 50.0] </cell>
      <velocities mode='thermal' units='kelvin'> 10.0 </velocities>
    </initialize>
    <forces>
      <force forcefield='pgl' weight='1.0'></force>
      <force forcefield='qc' weight='1.0'></force>
      <force forcefield='qc_mbpol' weight='1.0'></force>
    </forces>
    <ensemble>
      <temperature units='kelvin'>10.0</temperature>
      <pressure units='atmosphere'> 1.0 </pressure>
    </ensemble>
    <motion mode='dynamics'>
      <fixcom>True</fixcom>
      <dynamics mode='nve'>
	<timestep units='femtosecond'> 0.1 </timestep>
      </dynamics>
    </motion>
  </system>
</simulation>
